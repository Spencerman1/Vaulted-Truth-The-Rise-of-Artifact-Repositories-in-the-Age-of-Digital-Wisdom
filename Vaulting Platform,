// Reusable Components
function Card({ title, icon }) {
  return (
    <div className="p-4 bg-indigo-100 rounded-xl flex items-center gap-3">
      <i className={`lucide-${icon} text-xl`} />
      <span>{title}</span>
    </div>
  );
}

function Input({ label, ...props }) {
  return (
    <label className="block">
      <span className="text-sm font-medium">{label}</span>
      <input {...props} className="mt-1 w-full rounded border p-2" />
    </label>
  );
}

function Textarea({ label }) {
  return (
    <label className="block col-span-2">
      <span className="text-sm font-medium">{label}</span>
      <textarea className="mt-1 w-full rounded border p-2 h-24" />
    </label>
  );
}

function FileUpload({ label }) {
  return (
    <label className="block col-span-2">
      <span className="text-sm font-medium">{label}</span>
      <input type="file" className="mt-1 w-full" />
    </label>
  );
}

function Button({ children, variant = 'default', ...props }) {
  const base = "px-4 py-2 rounded font-semibold";
  const styles = {
    default: "bg-indigo-600 text-white hover:bg-indigo-700",
    destructive: "bg-red-600 text-white hover:bg-red-700"
  };
  return <button className={`${base} ${styles[variant]}`} {...props}>{children}</button>;
}

function ArtifactCard({ name, substrate, voltage, time, shadowUnits, qrCodeSrc }) {
  return (
    <div className="p-4 bg-gray-50 border rounded-xl flex gap-6 items-center">
      <img src={qrCodeSrc} alt="QR Code" className="w-20 h-20" />
      <div>
        <h3 className="text-lg font-bold">{name}</h3>
        <p>Substrate: {substrate}</p>
        <p>Voltage: {voltage}</p>
        <p>Plating Time: {time}</p>
        <p>Shadow Units: {shadowUnits}</p>
      </div>
    </div>
  );
}
